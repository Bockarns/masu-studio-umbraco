@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "_Layout.cshtml";
    var heroImage = Model.Value<Umbraco.Cms.Core.Models.MediaWithCrops>("heroImage");
    var heroPageLink = Model.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("heroPageLink");
    var artworks = Model.Value<IEnumerable<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>>("featuredArtworks")?.ToList();
    var newsPage = Model.Children().FirstOrDefault(x => x.ContentType.Alias == "newsPage");
    var latestNews = newsPage?.Children()
        .Where(x => x.Value<string[]>("postType")?.Contains("Nyhet") == true)
        .OrderByDescending(x => x.Value<DateTime>("postDate"))
        .Take(3)
        .ToList();
    var exhibitions = newsPage?.Children()
        .Where(x => x.Value<string[]>("postType")?.Contains("Utställning") == true)
        .OrderByDescending(x => x.Value<DateTime>("postDate"))
        .Take(3)
        .ToList();
}
<section class="hero d-flex align-items-center justify-content-center text-center text-white"
    style="background-image: url('@heroImage?.Url()'); background-size: cover; background-position: center; min-height: 500px;">
    <div class="bg-dark bg-opacity-50 p-5 rounded">
        <h1 class="display-4 fw-bold">@Model.Value("heroTitle")</h1>
        <p class="lead my-4">@Model.Value("heroText")</p>
        @if (heroPageLink != null)
        {
            <a href="@heroPageLink.Url()" class="btn btn-secondary btn-lg">@Model.Value("heroButtonText")</a>
        }
    </div>
</section>

<section class="mt-5 px-5">
    <h2 class="mb-4 text-center">Utvalda verk</h2>
    <div class="row align-items-start">
        
        <!-- Senaste nyheter - vänster -->
        <div class="col-md-2 offset-md-1">
            <div class="card shadow-sm p-3 h-100">
                <h6 class="fw-bold mb-3">Senaste nyheter</h6>
                @if (latestNews != null && latestNews.Any())
                {
                    @foreach (var post in latestNews)
                    {
                        var postDate = post.Value<DateTime>("postDate");
                        <div class="mb-3 pb-2 border-bottom">
                            <p class="text-muted mb-0" style="font-size: 0.75rem;">
                                @postDate.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("sv-SE"))
                            </p>
                            <a href="@post.Url()" class="text-decoration-none fw-bold" style="font-size: 0.85rem;">
                                @post.Value("postTitle")
                            </a>
                        </div>
                    }
                    <a href="/nyheter" class="btn btn-outline-secondary btn-sm w-100 mt-2">Alla nyheter →</a>
                }
                else
                {
                    <p class="text-muted small">Inga nyheter just nu.</p>
                }
            </div>
        </div>

        <!-- Karusell - mitten -->
        <div class="col-md-6">
            @if (artworks != null && artworks.Any())
            {
                <div id="artworkCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @for (int i = 0; i < artworks.Count; i++)
                        {
                            var artwork = artworks[i];
                            var img = artwork.Value<Umbraco.Cms.Core.Models.MediaWithCrops>("artImage");
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@img?.Url()" class="d-block w-100" style="max-height: 500px; object-fit: cover;" alt="@artwork.Value("artTitle")">
                                <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-2">
                                    <h5>@artwork.Value("artTitle")</h5>
                                    <a href="@artwork.Url()" class="btn btn-sm btn-light">Se mer</a>
                                </div>
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#artworkCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#artworkCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                </div>
            }
            else
            {
                <p>Inga verk att visa just nu.</p>
            }
        </div>

        <!-- Kommande utställningar - höger -->
        <div class="col-md-2">
            <div class="card shadow-sm p-3 h-100">
                <h6 class="fw-bold mb-3">Kommande utställningar</h6>
                @if (exhibitions != null && exhibitions.Any())
                {
                    @foreach (var ex in exhibitions)
                    {
                        var exDate = ex.Value<DateTime>("postDate");
                        <div class="mb-3 pb-2 border-bottom">
                            <p class="text-muted mb-0" style="font-size: 0.75rem;">
                                @exDate.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("sv-SE"))
                            </p>
                            <a href="@ex.Url()" class="text-decoration-none fw-bold" style="font-size: 0.85rem;">
                                @ex.Value("postTitle")
                            </a>
                        </div>
                    }
                    <a href="/nyheter" class="btn btn-outline-secondary btn-sm w-100 mt-2">Alla utställningar →</a>
                }
                else
                {
                    <p class="text-muted small">Inga kommande utställningar just nu.</p>
                }
            </div>
        </div>

    </div>
</section>