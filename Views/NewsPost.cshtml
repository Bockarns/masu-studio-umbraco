@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "_Layout.cshtml";
    var img = Model.Value<Umbraco.Cms.Core.Models.MediaWithCrops>("postImage");
    var postDate = Model.Value<DateTime>("postDate");
}

<article class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <a href="/nyheter" class="btn btn-link ps-0 mb-3">← Tillbaka till nyheter</a>
            <p class="text-muted small">
                @postDate.ToString("d MMMM yyyy")
            </p>
            <h1 class="mb-4">@Model.Value("postTitle")</h1>
            @if (img != null)
            {
                <img src="@img.Url()" class="img-fluid rounded shadow mb-4 w-100" 
                    style="max-height: 400px; object-fit: cover;">
            }
            <div class="mt-3">
                @Html.Raw(Model.Value("postContent"))
            </div>
        </div>
    </div>
</article>