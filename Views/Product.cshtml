@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "_Layout.cshtml";
    var img = Model.Value<Umbraco.Cms.Core.Models.MediaWithCrops>("productImage");
}

<section class="container mt-5">
    <div class="row">
        <div class="col-md-7">
            <img src="@img?.Url()" class="img-fluid rounded shadow" alt="@Model.Value("productName")">
        </div>
        <div class="col-md-5">
            <h1 class="mb-3">@Model.Value("productName")</h1>
            <p class="text-muted">@Model.Value("productCategory")</p>
            <p class="mt-3">@Model.Value("productDescription")</p>
            <p class="fw-bold fs-4 mt-4">@Model.Value("productPrice")</p>
            
            <div class="mt-3">
                <label class="form-label fw-bold">Antal</label>
                <input type="number" class="form-control w-25" id="quantity" value="1" min="1">
            </div>

            <button class="btn btn-lg mt-3 add-to-cart"
                data-name="@Model.Value("productName")"
                data-price="@Model.Value("productPrice")"
                data-id="@Model.Id"
                style="background-color: #1A3A4A; color: white;">
                Lägg i varukorg
            </button>

            <a href="/shop" class="btn btn-link mt-3 d-block">← Tillbaka till butiken</a>
        </div>
    </div>
</section>